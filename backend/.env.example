# ==== PLACEHOLDER ENV VARS - fill these in, then rename to .env ====

# Path to your Firebase service account JSON (download from Firebase Console > Project Settings > Service Accounts)
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# Firebase project / storage
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# CORS - comma separated list of allowed origins (your Flutter web build + custom domain)
ALLOWED_ORIGINS=http://localhost:PORT,https://your-custom-domain.com

# JWT / session secret (used for any custom short-lived tokens, e.g. media upload signing)
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Server
PORT=8000
